DB_DSN=
UDB_DSN=
EDB_DSN=
HTTP_ADDR=

# Rate limiting: minimum period in milliseconds between requests per identifier.
# 0 (default) = disabled.
#
# Three identifier scopes, independently configured for /locate and /update:
#   KEY     – X-Api-Key request header value
#   UUID    – sessionUUID from the request body
#   KEY_UUID – (X-Api-Key, sessionUUID) pair
#
# Example: set LOCATE_MIN_PERIOD_UUID=500 to reject /locate requests from the
# same session UUID that arrive less than 500 ms apart.
LOCATE_MIN_PERIOD_KEY=0
LOCATE_MIN_PERIOD_UUID=0
LOCATE_MIN_PERIOD_KEY_UUID=0
UPDATE_MIN_PERIOD_KEY=0
UPDATE_MIN_PERIOD_UUID=0
UPDATE_MIN_PERIOD_KEY_UUID=0

# Refresh: период автоматической перекачки UpdateDB → LocateDB, мс.
# 0 (default) = авто-refresh отключён, только ручной через POST /refresh.
REFRESH_PERIOD_MS=0
