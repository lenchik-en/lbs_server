DB_DSN=
UDB_DSN=
EDB_DSN=
HTTP_ADDR=

# Rate limiting: minimum period in milliseconds between requests.
# 0 (default) = disabled.
#
# KEY  — applies to clients with X-Api-Key header (rate limited by key value).
# ANON — applies to clients without a key (rate limited by sessionUUID from body).
#
# Example: LOCATE_MIN_PERIOD_ANON=1000 — анонимный клиент не чаще 1 раза в секунду на /locate.
LOCATE_MIN_PERIOD_KEY=0
LOCATE_MIN_PERIOD_ANON=0
UPDATE_MIN_PERIOD_KEY=0
UPDATE_MIN_PERIOD_ANON=0

# Refresh: период автоматической перекачки UpdateDB → LocateDB, мс.
# 0 (default) = авто-refresh отключён, только ручной через POST /refresh.
REFRESH_PERIOD_MS=0

# Проверка API-ключей (true/false). false = ключ необязателен, но если передан — валидируется.
REQUIRE_KEY_LOCATE=false
REQUIRE_KEY_UPDATE=false

# Учётные данные админ-панели (/admin/).
# Сгенерировать хэш пароля:
#   htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=
